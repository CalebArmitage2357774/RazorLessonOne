<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - RazorLesson</title>

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" integrity="sha384-9ndCyUaIbzAi2FUVXJi0CjmCapSmO7SnpJef0486qhLnuZ2cdeRhO02iuK6FUUVM" crossorigin="anonymous">
</head>

<body class="d-flex flex-column min-vh-100">
    <header class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light border-bottom box-shadow mb-3">
        <nav class="container-fluid">
            <a class="navbar-brand" href="/Index">RazorLesson</a>
            <ul class="navbar-nav flex-grow-1 justify-content-start">
                <li class="nav-item">
                    <a class="nav-link text-dark" href="/Index">Home</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-dark" href="/News">News</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-dark" href="/Privacy">Privacy</a>
                </li>
            </ul>
            <ul class="navbar-nav flex-grow-1 justify-content-end">
                <li class="nav-item">
                    <a class="nav-link text-dark" href="/Staff/Index">Staff</a>
                </li>
            </ul>
        </nav>
    </header>

    <main role="main" class="flex-shrink-0 container">
        @RenderBody()
    </main>

    <footer class="border-top footer text-muted text-center p-3 mt-auto">
        <div class="container">
            <p>&copy; @DateTime.Now.Year Copyright RazorLesson - @DateTime.Now.ToString("dd MMM yyyy")</p>
        </div>
    </footer>
</body>
</html>